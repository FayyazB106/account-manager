# Template for .env — copy to .env and set values as needed.
# Committed to source control; contains NO real secrets.
#
# The app is a single binary backed by embedded SQLite. Most settings have sane
# defaults, so a personal install needs nothing here — on first run you create a
# passphrase in the browser. For an unattended server, set MASTER_KEY. Real
# environment variables override anything in this file.

# --- Secrets ---------------------------------------------------------------

# MASTER_KEY encrypts every stored secret. Set this for unattended (server) mode.
# Generate one with:  go run ./cmd/api -gen-key
# If unset: on first run you set a passphrase in the browser (which seals a new
# key at data/master.key); on later starts you enter it in the browser to unlock.
# Back up this value — losing it (with no sealed-file fallback) means losing
# access to all encrypted data.
# MASTER_KEY=

# Supplies the passphrase non-interactively (CI, or dev convenience). Do NOT use
# in production — storing the passphrase is no better than storing the key.
# MASTER_PASSPHRASE=

# JWT signing secret. If unset, a persistent one is created at data/jwt.secret.
# JWT_SECRET=

# --- Paths & networking (optional; defaults shown) -------------------------

# DATA_DIR=./data                        # DB, key file, and backups live here
# DB_PATH=./data/account-manager.db
# KEY_PATH=./data/master.key
# BACKUP_DIR=./data/backups
# PORT=8080

# Bind-host override, for the initial server bootstrap before you set
# "Accessible on the network" in Settings -> Deployment (0.0.0.0 = all interfaces).
# HOST=0.0.0.0

# --- TLS (optional) --------------------------------------------------------
# Serve HTTPS directly by pointing these at a PEM cert + key. Leave unset to
# serve plain HTTP (the recommended org setup terminates TLS at the reverse
# proxy instead; localhost/personal mode never needs TLS). Both must be set.
# TLS_CERT=./data/cert.pem
# TLS_KEY=./data/key.pem